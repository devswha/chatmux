{
  "name": "chatmux",
  "private": true,
  "version": "1.8.18",
  "productName": "ChatMux",
  "description": "A self-hosted web interface for coding-agent sessions running in tmux",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "chatmux": "dist-server/server/cli.js"
  },
  "files": [
    "server/",
    "shared/",
    "dist/",
    "dist-server/",
    "dist-native/",
    "scripts/",
    "README.md"
  ],
  "homepage": "https://github.com/devswha/chatmux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devswha/chatmux.git"
  },
  "bugs": {
    "url": "https://github.com/devswha/chatmux/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run client\"",
    "server": "node dist-server/server/index.js",
    "server:dev": "tsx --env-file-if-exists=.env --tsconfig server/tsconfig.json server/index.js",
    "preserver:dev": "npm run build:core:dev",
    "server:dev-watch": "tsx watch --env-file-if-exists=.env --tsconfig server/tsconfig.json server/index.js",
    "preserver:dev-watch": "npm run build:core:dev",
    "client": "vite",
    "cua:fixture": "tsx --tsconfig server/tsconfig.json scripts/cua/run-fixture.ts",
    "cua:active:desktop": "bash scripts/cua/run-active-desktop.sh",
    "cua:tool:provision": "node scripts/cua/provision-computer-use.mjs",
    "cua:isolated:desktop": "bash scripts/cua/run-isolated-desktop.sh",
    "cua:mcp:evidence": "node scripts/cua/mcp-evidence.mjs",
    "cua:os:preflight": "node scripts/cua/os-preflight.mjs",
    "cua:pwa:evidence": "node scripts/cua/pwa-evidence.mjs",
    "cua:regressions": "node scripts/cua/run-regressions.mjs",
    "cua:release": "node scripts/cua/run-release-qa.mjs",
    "cua:summary": "node scripts/cua/summarize-run.mjs",
    "cua:tailscale:evidence": "node scripts/cua/tailscale-evidence.mjs",
    "cua:ui:interactions": "python3 scripts/cua/ui-interactions.py",
    "cua:mobile": "python3 scripts/cua/mobile-interactions.py",
    "cua:ui:evidence": "python3 scripts/cua/ui-evidence.py",
    "server:bundle": "npm run build && node scripts/release/build-server-bundle.js",
    "build": "npm run build:client && npm run build:server && npm run build:core",
    "build:client": "vite build",
    "build:core": "node scripts/build-rust-core.mjs --release",
    "build:core:dev": "node scripts/build-rust-core.mjs",
    "prebuild:server": "node -e \"require('node:fs').rmSync('dist-server', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "check:identity": "node scripts/check-identity.mjs",
    "release:check-metadata": "node scripts/release/check-release-metadata.mjs",
    "audit": "npm audit --audit-level=high",
    "check:core": "cargo fmt --manifest-path native/chatmux-core/Cargo.toml -- --check && cargo clippy --locked --manifest-path native/chatmux-core/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path native/chatmux-core/Cargo.toml",
    "test": "node scripts/run-tests.mjs",
    "pretest": "npm run build:core:dev",
    "lint": "eslint src/ server/ shared/ scripts/ vite.config.js tailwind.config.js",
    "lint:fix": "eslint src/ server/ shared/ scripts/ vite.config.js tailwind.config.js --fix",
    "verify": "node scripts/verify-owner.mjs",
    "verify:owned": "npm run audit && npm run typecheck && npm run check:core && npm test && npm run lint && npm run check:identity && npm run build",
    "start": "npm run build && npm run server",
    "postinstall": "node scripts/fix-node-pty.js",
    "prepare": "husky"
  },
  "keywords": [
    "chatmux",
    "claude code",
    "claude-code",
    "claude-code-ui",
    "codex",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "mobile IDE"
  ],
  "author": "devswha and ChatMux contributors",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "undici": "^8.9.0",
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.11.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iarna/toml": "^2.2.5",
    "@openai/codex-sdk": "0.144.6",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.16",
    "@uiw/react-codemirror": "^4.23.13",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "cross-spawn": "^7.0.3",
    "dompurify": "^3.4.7",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonc-parser": "3.3.1",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.25",
    "lucide-react": "^0.515.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.2.0-beta.12",
    "pretendard": "^1.3.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.25",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-test-renderer": "^18.0.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "node-gyp": "^13.0.1",
    "postcss": "^8.4.32",
    "react-test-renderer": "^18.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint",
    "server/**/*.{js,ts}": "eslint",
    "{shared,scripts}/**/*.{js,mjs,cjs,ts}": "eslint"
  }
}
